{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "前端: Vue (Vite dev)",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run dev",
      "cwd": "D:/demo/vue/vue-flask-deepseek",
      "env": {
        "BROWSER": "none"
      }
    },
    {
      "name": "前端: Browser (5173)",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:5173",
      "webRoot": "D:/demo/vue/vue-flask-deepseek/src"
    },
    {
      "name": "后端: run_app.py (Debug)",
      "type": "debugpy",
      "request": "launch",
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "program": "${workspaceFolder}/run_app.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": false,
      "subProcess": false,
      "env": {
        "PYTHONUNBUFFERED": "1",
        "PYDEVD_DISABLE_FILE_VALIDATION": "1" // 兼容性调整
      }
    },
    {
      "name": "后端: 调试当前文件(自动)",
      "type": "debugpy",
      "request": "launch",
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "program": "${file}",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": false,
      "purpose": [
        "debug-in-terminal"
      ],
      "env": {
        "PYTHONUNBUFFERED": "1",
        "PYTHONPATH": "${workspaceFolder}",
        "PYDEVD_DISABLE_FILE_VALIDATION": "1" // 兼容性调整
      }
    }
  ],
  "compounds": [
    {
      "name": "一起: Backend + Vue Dev",
      "stopAll": false,
      "configurations": [
        "后端: run_app.py (Debug)",
        "前端: Vue (Vite dev)"
      ]
    }
  ]
}
